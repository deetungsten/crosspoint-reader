  std::string pendingPath;
  size_t pageOffset = 0;
  size_t nextPageOffset = 0;
  bool hasMorePages = false;
  bool resumeDownloads = false;
  bool autoDownloadBatch = false;
  size_t autoDownloadScan = 0;
  size_t autoDownloadDone = 0;
